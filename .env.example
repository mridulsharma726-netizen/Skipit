# ==============================================================================
# SkipIt 3.0 Production Environment Configuration Template
# Strictly Zero-Commission P2P Marketplace (No Payment Gateways)
# ==============================================================================

# 1. Supabase (PostgreSQL & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. Backend & Real-Time WebSocket Server
PORT=5000
NODE_ENV=production
API_BASE_URL=https://api.yourdomain.com/api/v1
JWT_SECRET=generate_a_64_character_random_hex_secret
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# 3. Web Frontend (Next.js)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 4. SMS Provider (Choose: twilio, msg91, fast2sms, or mock)
SMS_PROVIDER=msg91

# Twilio (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Msg91 (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Fast2SMS (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# 5. Firebase Cloud Messaging (Push Notifications)
FIREBASE_SERVICE_ACCOUNT_KEY=./config/firebase-service-account.json
